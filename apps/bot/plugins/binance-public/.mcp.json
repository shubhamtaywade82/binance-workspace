{
  "mcpServers": {
    "binance-public": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server",
        "python",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/binance_public_mcp.py"
      ],
      "env": {
        "LOG_LEVEL": "WARNING",
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
}
